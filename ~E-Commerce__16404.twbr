            <column-instance column='[Quantity]' derivation='Sum' name='[sum:Quantity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1127281639141378]' derivation='User' name='[usr:Calculation_1127281639141378:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <computed-sort column='[federated.0c4jqw2016jgfg1bazcs705plizf].[none:Name:nk]' direction='ASC' using='[federated.0c4jqw2016jgfg1bazcs705plizf].[sum:Calculation_1127281638236161:qk]' />
          <filter class='quantitative' column='[federated.0c4jqw2016jgfg1bazcs705plizf].[none:TransactionDate:qk]' included-values='in-range'>
            <min>#2026-01-01 01:53:30#</min>
            <max>#2026-05-29 23:59:59#</max>
          </filter>
          <filter class='quantitative' column='[federated.0c4jqw2016jgfg1bazcs705plizf].[usr:Calculation_1127281639141378:qk]' included-values='in-range'>
            <min>1</min>
            <max>10</max>
          </filter>
          <slices>
