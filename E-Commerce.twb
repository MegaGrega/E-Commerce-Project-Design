            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Sort Order Toggle' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Most Popular&quot;'>
              <calculation class='tableau' formula='&quot;Most Popular&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c4jqw2016jgfg1bazcs705plizf'>
            <column caption='Sort Value' datatype='integer' name='[Calculation_1127281638236161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Most Popular&quot; THEN -[Quantity]&#13;&#10;ELSE [Quantity]&#13;&#10;END' />
            </column>
            <column caption='Dynamic Rank' datatype='integer' name='[Calculation_1127281639141378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(SUM([Calculation_1127281638236161]), &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column caption='Transaction Date' datatype='datetime' name='[TransactionDate]' role='dimension' type='ordinal' />
            <column-instance column='[Name]' derivation='None' name='[none:Name:nk]' pivot='key' type='nominal' />
