      <aliases enabled='yes' />
      <column caption='Last Transaction Date' datatype='datetime' name='[Calculation_0516228397502464]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [UserID] : MAX([TransactionDate]) }' />
      </column>
      <column caption='Is Active' datatype='boolean' name='[Calculation_0516228399161345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0516228397502464] &lt; #2026-03-30# OR ISNULL([Calculation_0516228397502464])' />
      </column>
      <column caption='User Status' datatype='string' name='[Calculation_0516228401704962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0516228397502464] &lt; [Parameters].[Parameter 2] OR ISNULL([Calculation_0516228397502464]) THEN &#13;&#10;    &quot;Inactive&quot;&#13;&#10;ELSE &#13;&#10;    &quot;Active (False)&quot;&#13;&#10;END' />
      </column>
      <column caption='Box' datatype='string' name='[Calculation_1127281628831744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Sort Value' datatype='integer' name='[Calculation_1127281638236161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Most Popular&quot; THEN -[Quantity]&#13;&#10;ELSE [Quantity]&#13;&#10;END' />
      </column>
      <column caption='Dynamic Rank' datatype='integer' name='[Calculation_1127281639141378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Calculation_1127281638236161]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Newest Rank' datatype='integer' name='[Calculation_1127281646788611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(ATTR([DateAdded]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Account Type' datatype='string' name='[Calculation_2133610047524864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([RegisteredUserID]) THEN &quot;Registered User&quot;&#13;&#10;ELSE &quot;Guest User&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Full Name' datatype='string' name='[Calculation_2133610056138753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName] + &quot; &quot; + [LastName]' />
      </column>
      <column caption='Stock Status' datatype='string' name='[Calculation_2133610079694850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quantity (inventory.csv)] = 0 THEN &quot;Out of Stock&quot;&#13;&#10;ELSEIF [Quantity (inventory.csv)] &lt;= [Parameters].[Parameter 3] THEN &quot;Low Stock&quot;&#13;&#10;END' />
      </column>
